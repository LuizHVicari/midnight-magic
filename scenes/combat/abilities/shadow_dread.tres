script = ExtResource("1_ability")
display_name = "Dread"
description = "A wave of darkness bursts out of you and every foe in reach is seized by terror and runs from you for a few seconds, attacking nothing. Heavy foes shake it off sooner. Reaches farther and lasts longer at night."
