[ext_resource type="Script" path="res://scenes/combat/shadow_step_action.gd" id="2_action"]

[resource]
script = ExtResource("1_ability")
display_name = "Shadow Step"
description = "Melt into shadow and step out where you aim, a few meters off. Aimed at a foe you come out right behind it. At night it goes twice as far, comes back faster and leaves you quiet."
cost = 20.0
cooldown = 8.0
action_script = ExtResource("2_action")
