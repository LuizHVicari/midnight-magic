[resource]
script = ExtResource("1_ability")
display_name = "Shadow Decoy"
description = "Puts a copy of yourself made of shadow where you aim. Foes that are not fighting come to look at it and keep coming back, so it draws them off. Lasts longer and calls from farther at night."
cost = 25.0
cooldown = 16.0
action_script = ExtResource("2_action")
