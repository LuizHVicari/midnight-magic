[ext_resource type="Script" path="res://scenes/combat/shadow_blackout_action.gd" id="2_action"]

[resource]
script = ExtResource("1_ability")
display_name = "Blackout"
description = "Spreads a zone of living darkness where you aim. Foes in it, or looking at you in it, see only a fifth as far, and your screen darkens at the edges so you know you are inside. A light of your own half undoes it."
cost = 45.0
cooldown = 30.0
action_script = ExtResource("2_action")
