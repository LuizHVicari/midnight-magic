[resource]
script = ExtResource("1_ability")
display_name = "Wind Bomb"
description = "A small ball of wind that throws everything near it away, you included. Cheap and quick to throw again and again: aimed at the ground under you it lifts you, so a stream of them can hold you in the air."
cost = 6.0
cooldown = 0.25
action_script = ExtResource("2_action")
